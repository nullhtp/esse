<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nullhtp.esse</string>
	<!-- The binary inside the bundle, so the app keeps its identity, its icon
	     and its Info.plist. `make login-item` writes the real path in. -->
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Quitting esse means quitting it: nothing brings it back until the next
	     login. -->
	<key>KeepAlive</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ESSE_START_HIDDEN</key>
		<string>1</string>
		<!-- The summon key. `make login-item HOTKEY=cmd-shift-space` writes a
		     different one in; a system-wide key can collide with anything. -->
		<key>ESSE_HOTKEY</key>
		<string>__HOTKEY__</string>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
